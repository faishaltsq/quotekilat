# Phase 1 runs locally without credentials. These flags do not enable unimplemented features.
VITE_FEATURE_CLOUD=false
VITE_FEATURE_AI_PARSE=false
VITE_FEATURE_MARKET_RESEARCH=false
VITE_FEATURE_BILLING=false

# Phase 2 — cloud workspace. Both values are publishable and safe in the bundle.
# Leave them unset to keep the app guest-only: the cloud panel then renders nothing.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never place service-role, AI, search or payment secrets in VITE_ variables.
# A service-role key in the browser grants full database access.
#
# Phase 3 — Smart Input. Server-only; see .env.server.example.
# The browser flag reveals the panel. The API route needs its own secrets, which
# are NOT read from VITE_ variables and never reach the bundle.
