# Phase 3 — server-only environment.
# These values are read by api/ai/parse.ts at request time. They are NOT
# VITE_ variables, so Vite never inlines them and they never reach the bundle.
# Set them in Vercel → Project → Settings → Environment Variables (Production).

# Verify the caller's own token and call the quota RPCs. The publishable key is
# safe to expose, but it is read here rather than in the browser so the API route
# can be exercised independently of the client build.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# OpenAI-compatible chat-completions endpoint. Leave empty to run Smart Input in
# labelled mock mode: the panel answers "Contoh AI (belum aktif)", applies nothing,
# and charges no quota.
#
# DeepSeek (direct):
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-flash
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional. Reasoning models (deepseek-flash, deepseek-v4-pro) emit hidden
# reasoning tokens before the JSON answer; "low" keeps a parse fast enough for the
# 30s function limit. Leave empty for providers that reject the field.
AI_REASONING_EFFORT=

# Optional salt for the per-IP throttle hash. Rotating it resets hourly counters.
AI_IP_PEPPER=
